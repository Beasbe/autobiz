<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AutoParser.Ocr</RootNamespace>
  </PropertyGroup>

  <!-- Windows-движок (WinRT) подключается только при сборке на Windows; собранный под Linux CLI его не несёт. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ProjectReference Include="..\AutoParser.Ocr.Windows\AutoParser.Ocr.Windows.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoParser.Core\AutoParser.Core.csproj" />
    <ProjectReference Include="..\AutoParser.Ocr.Linux\AutoParser.Ocr.Linux.csproj" />
  </ItemGroup>

</Project>
