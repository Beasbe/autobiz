<Window x:Class="AutoParser.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AutoParser.App.ViewModels"
        Title="AutoParser — сбор данных по заявке" Height="800" Width="1280" WindowState="Maximized"
        WindowStartupLocation="CenterScreen" FontSize="13">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <DockPanel>
        <!-- Панель команд -->
        <Border DockPanel.Dock="Top" Background="#F3F6FA" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Папка заявки:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Grid.Column="1" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Выбрать…" Command="{Binding BrowseCommand}" />
                    <Button Content="Обработать" Command="{Binding ProcessCommand}" FontWeight="SemiBold" />
                    <Button Content="Стоп" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <CheckBox Content="OCR сканов и фото" IsChecked="{Binding UseOcr}" IsEnabled="{Binding OcrAvailable}"
                              VerticalAlignment="Center" Margin="8,0" ToolTip="{Binding OcrInfo}" />
                    <CheckBox Content="Yandex Vision (облако)" IsChecked="{Binding UseYandex}" VerticalAlignment="Center"
                              Visibility="{Binding YandexAvailable, Converter={StaticResource BoolToVis}}"
                              ToolTip="Облачный OCR: лучше читает рукопись и плохие фото. Документы отправляются в Yandex Cloud." />
                </StackPanel>

                <TextBlock Grid.Row="2" Text="Шаблон:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Grid Grid.Row="2" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding TemplatePath}" VerticalContentAlignment="Center" />
                    <Button Grid.Column="1" Content="…" MinWidth="30" Command="{Binding BrowseTemplateCommand}" />
                    <TextBlock Grid.Column="2" Text="Сохранять в:" VerticalAlignment="Center" Margin="8,0,6,0" />
                    <TextBox Grid.Column="3" Text="{Binding OutputFolder}" VerticalContentAlignment="Center" />
                </Grid>
                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Отчёт (docx)" Command="{Binding ExportDocxCommand}" />
                    <Button Content="Повреждения (xlsx)" Command="{Binding ExportXlsxCommand}" />
                    <Button Content="Открыть папку" Command="{Binding OpenOutputCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Строка состояния -->
        <Border DockPanel.Dock="Bottom" Background="#F3F6FA" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" Padding="8,4">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="160" Height="12" IsIndeterminate="{Binding IsBusy}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Margin="12,0" Foreground="#555" />
                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="2*" MinWidth="150" />
            </Grid.ColumnDefinitions>

            <TabControl Margin="4">
                <TabItem Header="Данные ТС">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="*" MinHeight="90" />
                        </Grid.RowDefinitions>
                        <DataGrid ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedField}">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="{Binding RowBrush}" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Поле" Binding="{Binding Title}" IsReadOnly="True" Width="Auto" MaxWidth="280" />
                                <DataGridTextColumn Header="Значение (можно править)" Binding="{Binding Value, UpdateSourceTrigger=LostFocus}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Увер." Binding="{Binding Confidence}" IsReadOnly="True" Width="55" />
                                <DataGridTemplateColumn Header="Статус" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" ToolTip="{Binding Note}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Источник" Binding="{Binding Source}" IsReadOnly="True" Width="220">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding Note}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="#E6EAF0" />
                        <DockPanel Grid.Row="2">
                            <DockPanel DockPanel.Dock="Top" Margin="0,4">
                                <Button DockPanel.Dock="Right" Content="Взять этот вариант" Command="{Binding ApplyCandidateCommand}" />
                                <TextBlock VerticalAlignment="Center" Foreground="#555"
                                           Text="Все найденные варианты поля (выберите строку, чтобы увидеть фрагмент документа):" />
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="2*" />
                                    <DataGridTextColumn Header="Увер." Binding="{Binding Confidence}" Width="55" />
                                    <DataGridTextColumn Header="Документ" Binding="{Binding Document}" Width="3*" />
                                    <DataGridTextColumn Header="Текст в документе" Binding="{Binding Snippet}" Width="3*" />
                                    <DataGridTextColumn Header="Парсер" Binding="{Binding Parser}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Повреждения">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4">
                            <Button Content="Добавить строку" Command="{Binding AddDamageCommand}" />
                            <Button Content="Удалить строку" Command="{Binding RemoveDamageCommand}" />
                            <TextBlock VerticalAlignment="Center" Margin="12,0" Foreground="#555" TextWrapping="Wrap"
                                       Text="Из калькуляции Audatex / акта осмотра. Колонки исследования и относимости заполняет эксперт." />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Damages}" SelectedItem="{Binding SelectedDamage}" CanUserSortColumns="False">
                            <DataGrid.Resources>
                                <Style x:Key="Wrap" TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="№" Binding="{Binding No}" IsReadOnly="True" Width="35" />
                                <DataGridTextColumn Header="Поврежденный элемент" Binding="{Binding Element}" Width="2*" ElementStyle="{StaticResource Wrap}" />
                                <DataGridTextColumn Header="Характер повреждения" Binding="{Binding Character}" Width="2*" ElementStyle="{StaticResource Wrap}" />
                                <DataGridTextColumn Header="Иссл. ФО" Binding="{Binding FoStudy}" Width="*" ElementStyle="{StaticResource Wrap}" />
                                <DataGridTextColumn Header="Иссл. заявителя" Binding="{Binding ApplicantStudy}" Width="*" ElementStyle="{StaticResource Wrap}" />
                                <DataGridTextColumn Header="Фото" Binding="{Binding PhotoPresence}" Width="50" />
                                <DataGridTextColumn Header="Относимость" Binding="{Binding Relation}" Width="80" />
                                <DataGridTextColumn Header="Вывод, вид ремонта" Binding="{Binding Conclusion}" Width="1.5*" ElementStyle="{StaticResource Wrap}" />
                                <DataGridTextColumn Header="Увер." Binding="{Binding Confidence, StringFormat=P0}" IsReadOnly="True" Width="50" />
                                <DataGridTextColumn Header="Строка документа" Binding="{Binding RawText}" IsReadOnly="True" Width="1.5*" ElementStyle="{StaticResource Wrap}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Документы">
                    <DataGrid ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}" IsReadOnly="True">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                        <Setter Property="Foreground" Value="Gray" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Файл" Binding="{Binding Name}" Width="3*" />
                            <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="1.3*" />
                            <DataGridTextColumn Header="Стр." Binding="{Binding Pages}" Width="80" />
                            <DataGridTextColumn Header="Примечание" Binding="{Binding State}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Журнал">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="{Binding OcrInfo}" VerticalAlignment="Center" Foreground="#555" Margin="0,0,12,0" />
                            <Button Content="Очистить кэш OCR" Command="{Binding ClearCacheCommand}" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Log}" FontFamily="Consolas" FontSize="12" />
                    </DockPanel>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E6EAF0" />

            <!-- Превью страницы-источника -->
            <DockPanel Grid.Column="2" Margin="4">
                <DockPanel DockPanel.Dock="Top" Margin="0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="Масштаб" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#555" />
                        <Slider x:Name="Zoom" Minimum="0.2" Maximum="3" Value="0.6" Width="120" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding PreviewCaption}" TextWrapping="Wrap" FontWeight="SemiBold" />
                </DockPanel>
                <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Background="#FAFAFA">
                    <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Image x:Name="PreviewImage" Source="{Binding PreviewImage}" Stretch="None">
                            <Image.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding Value, ElementName=Zoom}" ScaleY="{Binding Value, ElementName=Zoom}" />
                            </Image.LayoutTransform>
                        </Image>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
